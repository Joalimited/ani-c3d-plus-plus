# Build environment for ani-c3d: native Linux build + MinGW cross build for a single static Windows exe.
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install --setopt=install_weak_deps=False --skip-unavailable \
      gcc-c++ cmake ninja-build pkgconf-pkg-config git file tar xz \
      SDL2-devel libcurl-devel sqlite-devel zlib-ng-compat-devel pcre2-devel mesa-libGL-devel \
      libX11-devel libXext-devel libXrandr-devel libXcursor-devel libXi-devel libXinerama-devel libXScrnSaver-devel \
      wayland-devel libxkbcommon-devel mesa-libEGL-devel pulseaudio-libs-devel \
      mingw64-gcc-c++ mingw64-winpthreads-static \
      mingw64-curl mingw64-curl-static mingw64-sqlite mingw64-sqlite-static mingw64-zlib mingw64-zlib-static \
      mingw64-pcre2 mingw64-pcre2-static mingw64-openssl-static mingw64-libssh2-static mingw64-libidn2-static \
      mingw64-libpsl-static mingw64-nghttp2-static mingw64-brotli-static mingw64-zstd-static mingw64-libunistring-static \
      mingw64-gettext-static mingw64-win-iconv-static \
    && dnf clean all
# SDL2 has no static MinGW package in Fedora: build it once from source.
RUN curl -fsSL https://github.com/libsdl-org/SDL/releases/download/release-2.30.12/SDL2-2.30.12.tar.gz | tar xz -C /tmp \
    && cmake -S /tmp/SDL2-2.30.12 -B /tmp/sdlw -G Ninja -DCMAKE_TOOLCHAIN_FILE=/usr/share/mingw/toolchain-mingw64.cmake \
         -DCMAKE_BUILD_TYPE=Release -DSDL_SHARED=OFF -DSDL_STATIC=ON -DSDL_TEST=OFF -DCMAKE_INSTALL_PREFIX=/opt/sdl2-mingw \
    && cmake --build /tmp/sdlw && cmake --install /tmp/sdlw && rm -rf /tmp/SDL2-2.30.12 /tmp/sdlw
RUN dnf -y install --setopt=install_weak_deps=False libwebp-devel && dnf clean all
# curl for Windows on static OpenSSL (TLS 1.3: MangaDex refuses older TLS, and Windows 10's Schannel has no 1.3);
# certificates come from the Windows store at run time (CURLSSLOPT_NATIVE_CA). No psl / idn / http2 / ssh.
RUN curl -fsSL https://curl.se/download/curl-8.11.1.tar.xz | tar xJ -C /tmp \
    && cmake -S /tmp/curl-8.11.1 -B /tmp/cw -G Ninja -DCMAKE_TOOLCHAIN_FILE=/usr/share/mingw/toolchain-mingw64.cmake \
         -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DBUILD_STATIC_LIBS=ON -DBUILD_CURL_EXE=OFF -DBUILD_TESTING=OFF \
         -DCURL_USE_SCHANNEL=OFF -DCURL_USE_OPENSSL=ON -DOPENSSL_USE_STATIC_LIBS=ON -DCURL_USE_LIBPSL=OFF -DUSE_LIBIDN2=OFF -DUSE_NGHTTP2=OFF \
         -DCURL_BROTLI=OFF -DCURL_ZSTD=OFF -DCURL_USE_LIBSSH2=OFF -DCURL_DISABLE_LDAP=ON -DENABLE_UNICODE=OFF \
         -DCURL_ZLIB=ON -DZLIB_USE_STATIC_LIBS=ON -DCMAKE_INSTALL_PREFIX=/opt/curl-mingw \
    && cmake --build /tmp/cw && cmake --install /tmp/cw && rm -rf /tmp/curl-8.11.1 /tmp/cw
RUN curl -fsSL https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.4.0.tar.gz | tar xz -C /tmp \
    && cmake -S /tmp/libwebp-1.4.0 -B /tmp/ww -G Ninja -DCMAKE_TOOLCHAIN_FILE=/usr/share/mingw/toolchain-mingw64.cmake \
         -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DWEBP_BUILD_ANIM_UTILS=OFF -DWEBP_BUILD_CWEBP=OFF -DWEBP_BUILD_DWEBP=OFF \
         -DWEBP_BUILD_GIF2WEBP=OFF -DWEBP_BUILD_IMG2WEBP=OFF -DWEBP_BUILD_VWEBP=OFF -DWEBP_BUILD_WEBPINFO=OFF -DWEBP_BUILD_WEBPMUX=OFF \
         -DWEBP_BUILD_EXTRAS=OFF -DCMAKE_INSTALL_PREFIX=/opt/webp-mingw \
    && cmake --build /tmp/ww && cmake --install /tmp/ww && rm -rf /tmp/libwebp-1.4.0 /tmp/ww
RUN dnf -y install --setopt=install_weak_deps=False --skip-unavailable 7zip p7zip p7zip-plugins zip && dnf clean all
# Mesa's software OpenGL (llvmpipe) for Windows PCs without a GPU driver (VMs, old machines): ani-c3d falls back to it
# when the system has no OpenGL 3.3. Only the x64 GL DLLs are kept, zipped, and embedded in the exe.
RUN mkdir -p /tmp/mesa && cd /tmp/mesa \
    && curl -fsSLo m.7z https://github.com/pal1000/mesa-dist-win/releases/download/26.2.4/mesa3d-26.2.4-release-mingw.7z \
    && (7z x -y m.7z x64 >/dev/null || 7za x -y m.7z x64 >/dev/null) \
    && cd x64 && ls && zip -9 /opt/mesa.zip opengl32.dll libgallium_wgl.dll $(ls libglapi.dll 2>/dev/null) && cd / && rm -rf /tmp/mesa && ls -la /opt/mesa.zip
RUN dnf -y install --setopt=install_weak_deps=False --skip-unavailable libglvnd-devel mesa-libGLES-devel && dnf clean all
